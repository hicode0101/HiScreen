{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HiScreen",
  "identifier": "com.hicode.hiscreen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1530",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HiScreen — 局域网屏幕分享",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
